# ==========================================================================
# KAVARI · Variables de entorno
# ==========================================================================

# Puerto del servidor (opcional). Default: 3007
PORT=

# --------------------------------------------------------------------------
# Configuracion de Supabase (FRONTEND, valores publicos por diseno).
# La URL y la ANON/publishable key son publicas a proposito (el navegador
# las necesita). La proteccion real son las politicas RLS de la base de
# datos. NO incluyas aqui la service_role key ni el client secret de Google.
# --------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Client ID de Google OAuth (valor publico; el navegador lo necesita).
# El secret NO debe ir en el frontend.
# GOOGLE_CLIENT_ID=
