# ==========================================================================
# KAVARI · Variables de entorno necesarias
# ==========================================================================
# Copia este archivo como .env en la raíz (o server/.env para el servidor)
# y rellena los valores. NUNCA subas el archivo .env a git (ya está en
# .gitignore). Las claves reales van solo en tu máquina / producción.

# Clave de API de Google (Gemini) — https://aistudio.google.com/apikey
# La usan los scripts de prueba: server/test-final.js y server/test-fixes.js
GCP_API_KEY=

# Clave de API Gemini que lee el servidor (server/index.js).
# Se lee de process.env.GEMINI_API_KEY o del archivo server/.env
GEMINI_API_KEY=

# Modelo de Gemini (opcional). Default: gemini-flash-latest
GEMINI_MODEL=

# Puerto del servidor (opcional). Default: 3007
PORT=

# --------------------------------------------------------------------------
# Configuración de Supabase (FRONTEND, valores públicos por diseño).
# La URL y la ANON/publishable key son públicas a propósito (el navegador
# las necesita). La protección real son las políticas RLS de la base de
# datos. NO incluyas aquí la service_role key ni el client secret de Google.
# --------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Client ID de Google OAuth (valor público; el navegador lo necesita).
# El secret NO debe ir en el frontend.
# GOOGLE_CLIENT_ID=